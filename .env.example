# Copy this file to `.env` and fill in keys for the providers you'll use.
# `.env` is gitignored — never commit real keys.
#
# scripts/eval and scripts/chat load this file via `tsx --env-file=.env`,
# so `.env` must exist (even if some keys are blank) or those scripts error.

# --- Providers wired into the eval/chat runner ---
# Frontier paid + cheap first-party models:
ANTHROPIC_KEY=...   # claude-*        (console.anthropic.com)
GEMINI_KEY=...      # gemini-*        (aistudio.google.com) — also the default judge
OPENAI_KEY=...      # gpt-*           (platform.openai.com)

# Hosted open-source models (Llama, Qwen, DeepSeek, Mistral, GLM, Kimi, ...).
# One key proxies many vendors — use `-m openrouter/<slug>`:
OPENROUTER_KEY=...  # openrouter/*    (openrouter.ai/keys)

# --- Local models (Ollama / LM Studio), via `-m local/<model>` ---
# LOCAL_API_KEY is usually unnecessary for local servers.
LOCAL_API_KEY=...
LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama default; LM Studio: http://localhost:1234/v1

# --- MCP server (Producer Pal must be running in Ableton Live) ---
MCP_URL=http://localhost:3350/mcp

# --- Not wired into the eval runner today (kept for reference) ---
# OpenRouter already covers these models, so they aren't required.
MISTRAL_KEY=...
VERTEX_KEY=...
GROQ_KEY=...
FIREWORKSAI_KEY=...
HUGGINGFACE_KEY=...
