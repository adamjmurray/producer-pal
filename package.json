{
  "name": "producer-pal",
  "version": "2.3.0-rc2",
  "description": "Producer Pal — Ableton MCP server bringing AI to Ableton Live via a Max for Live device",
  "homepage": "https://producer-pal.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamjmurray/producer-pal.git"
  },
  "type": "module",
  "imports": {
    "#webui/*": "./webui/src/*",
    "#src/*": "./src/*",
    "#evals/*": "./evals/*"
  },
  "author": "Adam Murray",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "music",
    "ai",
    "mcp",
    "ableton",
    "ableton-mcp",
    "ableton-live-mcp",
    "ai-for-ableton",
    "ableton-ai",
    "max-for-live",
    "ai-music-production"
  ],
  "scripts": {
    "build": "node scripts/build-and-release/helpers/check-build-flags.ts && npm run parser:build && npm run ui:build && rolldown -c config/rolldown.config.mjs && npm run dxt:build",
    "build:debug": "ALLOW_DEV_BUILD_FLAGS=true ENABLE_LIVE_API=true npm run build",
    "build:watch": "npm run build && rolldown -c config/rolldown.config.mjs -w",
    "dev": "npm run parser:build && rolldown -c config/rolldown.config.mjs -w",
    "dev:debug": "ENABLE_LIVE_API=true npm run dev",
    "test": "npm run test:setup && vitest run --reporter=./config/vitest-minimal-reporter.mjs --silent=true",
    "test:watch": "npm run test:setup && vitest --reporter=dot --silent=true",
    "test:coverage": "npm run test:setup && vitest run --coverage --reporter=./config/vitest-minimal-reporter.mjs --reporter=json --outputFile.json=test-reports/vitest.json --silent=true",
    "test:verbose": "npm run test:setup && vitest run --reporter=default --silent=true",
    "test:coverage:verbose": "npm run test:setup && vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-reports/vitest.json --silent=true",
    "test:setup": "npm run parser:build",
    "coverage": "npm run test:coverage",
    "mutation": "node config/run-mutation.mjs",
    "check": "npm run lint --silent && npm run typecheck --silent && npm run format:check --silent && npm run validate:typescript-only --silent && npm run duplication --silent && npm run test:coverage --silent",
    "check:build": "npm run build && npm run docs:build",
    "fix": "npm run lint:fix && npm run format",
    "parser:build": "peggy --format es --output src/notation/barbeat/parser/generated-barbeat-parser.js src/notation/barbeat/parser/barbeat-grammar.peggy && peggy --format es --output src/notation/transform/parser/generated-transform-parser.js src/notation/transform/parser/transform-grammar.peggy && peggy --format es --output src/notation/stark/parser/generated-stark-parser.js src/notation/stark/parser/stark-grammar.peggy && peggy --format es --output src/notation/midi-json/parser/generated-midi-json-parser.js src/notation/midi-json/parser/midi-json-grammar.peggy",
    "parser:watch": "chokidar 'src/**/*.peggy' -c 'npm run parser:build'",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "echo 'Linting...' && oxlint --type-aware && echo 'No lint violations.\n'",
    "lint:fix": "oxlint --type-aware --fix",
    "duplication": "node scripts/run-parallel.ts duplication:src duplication:tests duplication:scripts duplication:evals duplication:e2e",
    "duplication:src": "printf 'Source ' && jscpd -s --no-colors -c config/.jscpd.json",
    "duplication:tests": "printf 'Tests ' && jscpd -s --no-colors -c config/.jscpd-tests.json",
    "duplication:scripts": "printf 'Scripts ' && jscpd -s --no-colors -c config/.jscpd-scripts.json",
    "duplication:evals": "printf 'Evals ' && jscpd -s --no-colors -c config/.jscpd-evals.json",
    "duplication:e2e": "printf 'E2E ' && jscpd -s --no-colors -c config/.jscpd-e2e.json",
    "duplication:verbose": "jscpd -c config/.jscpd.json && jscpd -c config/.jscpd-tests.json && jscpd -c config/.jscpd-scripts.json && jscpd -c config/.jscpd-evals.json && jscpd -c config/.jscpd-e2e.json",
    "skills:snapshot": "node scripts/skills/snapshot-skills.ts",
    "loc": "node scripts/stats/loc.ts",
    "test:stats": "node scripts/stats/test-stats.ts",
    "e2e:stats": "node scripts/stats/e2e-stats.ts",
    "knowledge-base": "node scripts/build-and-release/generate-knowledge-base.ts",
    "kb": "npm run knowledge-base",
    "dxt:clean": "rm -f claude-desktop-extension/*.mcpb claude-desktop-extension/*.js claude-desktop-extension/manifest.json claude-desktop-extension/LICENSE",
    "dxt:build": "node scripts/build-and-release/build-claude-desktop-extension.ts",
    "version:bump": "npm run version:bump:patch",
    "version:bump:patch": "node scripts/build-and-release/bump-version.ts patch",
    "version:bump:minor": "node scripts/build-and-release/bump-version.ts minor",
    "version:bump:major": "node scripts/build-and-release/bump-version.ts major",
    "version:bump:rc": "node scripts/build-and-release/bump-version.ts rc",
    "version:bump:ga": "node scripts/build-and-release/bump-version.ts ga",
    "version:bump:to": "node scripts/build-and-release/bump-version.ts to",
    "release": "node scripts/build-and-release/prepare-release.ts",
    "tag": "node scripts/build-and-release/create-tag.ts",
    "tc": "npm run typecheck",
    "typecheck": "echo 'Typechecking...' && node scripts/run-parallel.ts typecheck:src typecheck:scripts typecheck:evals typecheck:webui typecheck:config typecheck:e2e:webui typecheck:e2e:ui typecheck:e2e:mcp typecheck:e2e:portal typecheck:e2e:docs && echo 'No typecheck violations.\n'",
    "typecheck:src": "tsc --project src/tsconfig.json",
    "typecheck:config": "tsc --project config/tsconfig.json",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "typecheck:evals": "tsc --project evals/tsconfig.json",
    "typecheck:webui": "tsc --project webui/tsconfig.json",
    "typecheck:e2e": "tsc --project e2e/webui/tsconfig.json && tsc --project e2e/ui/tsconfig.json && tsc --project e2e/mcp/tsconfig.json && tsc --project e2e/portal/tsconfig.json && tsc --project e2e/docs/tsconfig.json",
    "typecheck:e2e:webui": "tsc --project e2e/webui/tsconfig.json",
    "typecheck:e2e:ui": "tsc --project e2e/ui/tsconfig.json",
    "typecheck:e2e:mcp": "tsc --project e2e/mcp/tsconfig.json",
    "typecheck:e2e:portal": "tsc --project e2e/portal/tsconfig.json",
    "typecheck:e2e:docs": "tsc --project e2e/docs/tsconfig.json",
    "ui:build": "vite build --config config/vite.config.ts",
    "ui:dev": "vite --config config/vite.config.ts",
    "ui:test": "npm run ui:build && playwright test -c config/playwright.ui.config.ts",
    "ui:test:dev": "npm run ui:build && playwright test -c config/playwright.ui.config.ts --ui",
    "validate:typescript-only": "node scripts/build-and-release/validate-typescript-only.ts",
    "docs:dev": "npm run docs:generate && vitepress dev docs --port 5174",
    "docs:schemas": "node scripts/build-and-release/tool-reference/generate-tool-schema-docs.ts",
    "docs:examples": "npm run parser:build && node scripts/build-and-release/tool-reference/generate-tool-output-docs.ts",
    "docs:generate": "npm run docs:schemas && npm run docs:examples && node scripts/build-and-release/generate-docs-markdown.ts && node scripts/build-and-release/generate-skill-downloads.ts",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:test": "npm run docs:build && playwright test -c config/playwright.docs.config.ts",
    "docs:test:dev": "npm run docs:build && playwright test -c config/playwright.docs.config.ts --ui",
    "docs:test:headed": "npm run docs:build && playwright test -c config/playwright.docs.config.ts --headed",
    "e2e:docs": "npm run docs:test",
    "e2e:mcp": "vitest run -c config/vitest.e2e.config.ts",
    "e2e:mcp:watch": "vitest -c config/vitest.e2e.config.ts",
    "e2e:portal": "vitest run -c config/vitest.e2e.portal.config.ts",
    "e2e:webui": "node --env-file=.env node_modules/.bin/playwright test -c config/playwright.webui.config.ts",
    "e2e:webui:dev": "node --env-file=.env node_modules/.bin/playwright test -c config/playwright.webui.config.ts --ui"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.41",
    "@ai-sdk/google": "4.0.50",
    "@ai-sdk/mistral": "4.0.32",
    "@ai-sdk/openai": "4.0.46",
    "@ai-sdk/openai-compatible": "3.0.35",
    "@ai-sdk/provider-utils": "5.0.29",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@google/genai": "2.18.0",
    "@lezer/highlight": "1.2.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/agents": "0.17.0",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@tailwindcss/typography": "0.5.20",
    "ai": "7.0.77",
    "dompurify": "3.4.14",
    "express": "5.2.1",
    "idb": "8.0.3",
    "marked": "18.0.10",
    "preact": "10.29.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/preact": "3.2.4",
    "@types/express": "5.0.6",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "chokidar-cli": "3.0.0",
    "commander": "15.0.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "72.0.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.11.6",
    "jscpd": "5.0.16",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "peggy": "5.1.0",
    "rolldown": "1.2.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "undici": "8.10.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  },
  "overrides": {
    "external-editor": {
      "tmp": "0.2.7"
    },
    "qs": "6.15.3"
  }
}
