        "use-isnan": "error",
        "valid-typeof": "error",
        "eqeqeq": [
          "error",
          "always",
          {
            "null": "ignore"
          }
        ],
        "yoda": ["error", "never"],
        "no-var": "error",
        "prefer-const": "error",
        "@eslint-community/eslint-comments/require-description": [
          "error",
          {
            "ignore": []
          }
        ],
        "no-implicit-coercion": "error",
        "default-param-last": "error",
        "no-lonely-if": "error",
        "no-self-compare": "error",
        "no-else-return": "error",
        "no-unneeded-ternary": "error",
