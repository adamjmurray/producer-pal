    // oxlint attaches an enclosing function's JSDoc block to a nested arrow that
    // is assigned to a GLOBAL member, then demands tags for the arrow's
    // signature. Repro: a documented `function f(): void { window.confirm = () =>
    // false; }` reports jsdoc/require-returns on the arrow. Only test helpers
    // stub globals that way, so scope it here and keep production code covered.
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*-test-helpers.ts"],
      "rules": {
        "jsdoc/require-param": "off",
        "jsdoc/require-returns": "off"
      },
      "plugins": ["jsdoc"]
    },
    // oxlint's checker calls this assertion redundant; tsc does not — dropping
    // it fails typecheck with "Property 'id' does not exist on type 'object'".
    // Narrowing createdObjects past object[] would touch five files of
    // production code, so the disagreement is recorded here instead.
    {
      "files": [
        "src/tools/actions/duplicate/helpers/duplicate-focus-helpers.ts"
      ],
      "plugins": ["typescript"],
      "rules": {
        "typescript/no-unnecessary-type-assertion": "off"
